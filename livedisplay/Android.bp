cc_binary {
    name: "vendor.lineage.livedisplay-service.hormoz",
    vintf_fragments: ["vendor.lineage.livedisplay-service.hormoz.xml"],
    init_rc: ["vendor.lineage.livedisplay-service.hormoz.rc"],
    relative_install_path: "hw",
    srcs: [
        "SunlightEnhancement.cpp",
        "service.cpp",
    ],
    vendor: true,
    shared_libs: [
        "libbase",
        "libutils",
        "libbinder",
        "libbinder_ndk",
        "vendor.lineage.livedisplay-V1-ndk",
    ],
}
